---
layout: base.njk
title: "Projects"
---

<section class="intro">
  <p><b>Hi, I'm Colin.</b></p>
  <section class="intro-sub">
    <p>I'm a sophomore at UT Austin majoring in computer science. I like to make games, tools, and other stuff.</p>
  </section>
</section>

<section class="projects-section">
  <div class="tag-filter">
    <button class="tag-btn active" data-tag="all">all</button>
    {% for tag in collections.projectTags %}
      <button class="tag-btn" data-tag="{{ tag }}">{{ tag }}</button>
    {% endfor %}
  </div>

  <div class="projects-grid">
    {% for project in collections.projects %}
    <a href="{{ project.url }}" class="project-card" data-tags="{{ project.data.tags | join(',') }}">
      {% if project.data.image %}
        <img src="{{ project.data.image }}" alt="{{ project.data.title }}" class="card-thumb">
      {% endif %}
      <div class="card-inner">
        <h2>{{ project.data.title }}</h2>
        <p class="project-desc">{{ project.data.description | safe }}</p>
        <div class="tag-list">
          {% for tag in project.data.tags %}
            <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tag-btn');
  const cards = document.querySelectorAll('.project-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selected = btn.dataset.tag;
      cards.forEach(card => {
        const tags = card.dataset.tags.split(',');
        card.style.display = (selected === 'all' || tags.includes(selected)) ? '' : 'none';
      });
    });
  });
</script>