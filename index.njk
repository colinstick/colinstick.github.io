---
layout: base.njk
title: "Projects"
---

<section class="intro">
  <p class="boil" data-boil-scale="5" data-boil-speed="200"><b>Hi, I'm Colin.</b></p>
  <section class="intro-sub">
    <p>I'm a sophomore at UT Austin majoring in computer science. I like to make games, tools, and other stuff.</p>
  </section>
  <hr class="boil" data-boil-scale="5" data-boil-speed="200"
        style="height: 0.2rem; background-color: #FFFFFF;
        margin-top: 2rem; margin-bottom: 0rem;">
</section>


<section class="projects-section">
  <div class="tag-filter">
    <button class="tag-btn active" data-tag="all">all</button>
    {% for tag in collections.projectTags %}
      {% set customTagColor = tag | tagColor(tagColors) %}
      <button
        class="tag-btn boil"
        data-boil-hover="true"
        data-tag="{{ tag }}"
        {% if customTagColor %}style="--tag-color: {{ customTagColor }}"{% endif %}
      >{{ tag }}</button>
    {% endfor %}
  </div>

  <div class="projects-grid">
    {% for project in collections.projects %}
    <article class="project-card" data-tags="{{ project.data.tags | join(',') }}">
      <a href="{{ project.url }}" class="card-content-link">
        {% if project.data.image %}
          <img src="{{ project.data.image }}" alt="{{ project.data.title }}" class="card-thumb">
        {% endif %}
        <div class="card-inner">
          <div class="card-title-row">
            <h2>{{ project.data.title }}</h2>
            {% if project.data.link or project.data.github %}
              <div class="card-actions">
                {% if project.data.link %}
                  <a href="{{ project.data.link }}" class="card-action-btn card-action-play" aria-label="View project for {{ project.data.title }}" target="_blank" rel="noopener noreferrer">▶</a>
                {% endif %}
                {% if project.data.github %}
                  <a href="{{ project.data.github }}" class="card-action-btn card-action-github" aria-label="View github for {{ project.data.title }}" target="_blank" rel="noopener noreferrer">GitHub</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
          <p class="project-desc">{{ project.data.description | safe }}</p>
          <div class="tag-list">
            {% for tag in project.data.tags %}
              {% set customTagColor = tag | tagColor(tagColors) %}
              <span class="tag" {% if customTagColor %}style="--tag-color: {{ customTagColor }}"{% endif %}>{{ tag }}</span>
            {% endfor %}
          </div>
        </div>
      </a>
    </article>
    {% endfor %}
  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.tag-btn');
  const cards = document.querySelectorAll('.project-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selected = btn.dataset.tag;
      cards.forEach(card => {
        const tags = card.dataset.tags.split(',');
        card.style.display = (selected === 'all' || tags.includes(selected)) ? '' : 'none';
      });
    });
  });
</script>