---
layout: base.njk
title: "Blog"
---

<section class="blog-section">
  <h1>blog</h1>
  <p class="blog-subtitle">This is where I will write stuff... if I feel like it.</p>

  <br>

  <ul class="post-list">
    {% for post in collections.posts %}
    <li class="post-item">
        <div class="post-item-top">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
            <span class="post-date">{{ post.date | fullDate }}</span>
        </div>

        {% if post.data.description %}
            <p class="post-description"><i>{{ post.data.description }}</i></p>
        {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>