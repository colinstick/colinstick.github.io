---
layout: base.njk
---

<article class="blog-post">
  <header class="post-header">
    <p class="post-date">{{ date | fullDate }}</p>
    <h1>{{ title }}</h1>

    {% if description %}
    <p class="post-description">{{ description }}</p>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

  <footer class="post-footer">
    <a href="/blog/">← back to blog</a>
  </footer>
</article>