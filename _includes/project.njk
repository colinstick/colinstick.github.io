---
layout: base.njk
---

<article class="project-page">
  <header class="project-header">
    <div class="tag-list">
      {% for tag in tags %}
        {% set customTagColor = tag | tagColor(tagColors) %}
        <span class="tag" {% if customTagColor %}style="--tag-color: {{ customTagColor }}"{% endif %}>{{ tag }}</span>
      {% endfor %}
    </div>
    <h1>{{ title }}</h1>
    <p class="detail-date">{{ date | readableDate }}</p>
    <p class="project-meta">{{ description }}</p>
    {% if link or github %}
      <div class="project-links">
        {% if link %}
          <a href="{{ link }}" class="project-link" target="_blank" rel="noopener noreferrer">→ view project</a>
        {% endif %}
        {% if github %}
          <a href="{{ github }}" class="project-link" target="_blank" rel="noopener noreferrer">→ view github</a>
        {% endif %}
      </div>
    {% endif %}
  </header>

  <div class="project-content">
    {{ content | safe }}
  </div>

  <footer class="project-footer">
    <a href="/">← back to projects</a>
  </footer>
</article>